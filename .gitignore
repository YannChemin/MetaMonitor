# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Build output
grass/libmmgrass.so
*.o

# Debian packaging intermediates (dpkg-buildpackage)
debian/.debhelper/
debian/metamonitor/
debian/files
debian/debhelper-build-stamp
debian/*.debhelper
debian/*.debhelper.log
debian/*.substvars

# dist/ stays local, except the one .deb the README installs: superseded
# packages, debug symbols and build records do not belong in the repository.
# At each release, point the exception at the new file and "git rm --cached"
# the old one; a tracked file needs "git add -f" while dist/* is ignored.
dist/*
!dist/metamonitor_0.2.2_amd64.deb
